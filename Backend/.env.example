# ECHO backend configuration. Copy to Backend/.env -- .env is gitignored, never commit it.
#
# Docker Compose reads Backend/.env into the API, the scheduler and every worker
# (Compose 2.24 or later). Edit the active lines below to tune the stack; an
# absent key, or `KEY=` with no value, uses the code default.
#
# For a native run (no Docker) the processes read the same keys from the shell:
#   set -a; . ./.env; set +a
#
# Secrets (S3 keys, Redis passwords) are injected through the environment only.

# --- Runtime --------------------------------------------------------------------
# "production" enforces SRS SE-2: COOKIE_SECURE=true and https origins.
ENVIRONMENT=development

# Sessions and job artifacts expire after 24 hours (SRS PE-3).
SESSION_TTL_SECONDS=86400
JOB_TTL_SECONDS=86400

# --- Session cookie and CORS ----------------------------------------------------
SESSION_COOKIE_NAME=sid
COOKIE_SECURE=false
# lax, strict, or none; none requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Leave unset for localhost.
# COOKIE_DOMAIN=
# Comma-separated browser origins, scheme://host:port with no trailing slash.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Limits (SRS PE-3) ----------------------------------------------------------
MAX_UPLOAD_BYTES=104857600
MAX_AUDIO_DURATION_SECONDS=600
TASK_SOFT_TIME_LIMIT_SECONDS=3300
TASK_TIME_LIMIT_SECONDS=3600
# Derived from TASK_TIME_LIMIT_SECONDS when unset; must stay ordered after it.
# BROKER_VISIBILITY_TIMEOUT_SECONDS=
# STALE_JOB_SECONDS=
# STALE_JOB_SWEEP_SECONDS=300

# --- Workers --------------------------------------------------------------------
# Model variants a worker keeps loaded, and how long an idle one survives.
MODEL_REGISTRY_MAX_ENTRIES=3
MODEL_REGISTRY_IDLE_SECONDS=1800
# Saliency analysis window in seconds (SHAP uses the stricter one), and SHAP samples.
MAX_SALIENCY_SECONDS=12
MAX_SALIENCY_SECONDS_SHAP=6
SALIENCY_SHAP_SAMPLES=8
# Keep eager attention on the CPU: on some torch/Triton builds it segfaults on the GPU.
ATTENTION_FORCE_CPU=true
# FR-10 fairness analysis minimums.
FR10_MIN_GROUP_SIZE=8
FR10_MIN_SPEAKERS_PER_GROUP=2
# Part of every result's cache identity; set it per release.
# CODE_VERSION=development

# --- Set by docker-compose.yml per service; used only by native runs ------------
# Compose pins these to its own network and mounts, whatever this file says.
# REDIS_URL=redis://localhost:6379/0
# JOB_REDIS_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/2
# CELERY_RESULT_BACKEND=redis://localhost:6379/3
# STORAGE_BACKEND=local
# STORAGE_LOCAL_ROOT=shared-storage
# auto, cpu, mps, cuda, cuda:<index>, nvidia, rocm, or amd
# ML_DEVICE=auto
# The legacy synchronous routes need the ML runtime; the API image does not have it.
# ENABLE_LEGACY_SYNC_INFERENCE=false

# --- Production -----------------------------------------------------------------
# A production deployment (SAD section 7) runs the same images with this
# configuration: every Redis role on a private, authenticated TLS endpoint --
# each in its own logical database, all persistent and non-evicting -- S3
# object storage with the 24-hour lifecycle rule in Backend/s3-lifecycle.json,
# and Secure cookies. Celery's broker and result backend need `ssl_cert_reqs`
# on a rediss:// URL. Replace CHANGE_ME and the example hosts.
# >>> production
# ENVIRONMENT=production
# REDIS_URL=rediss://:CHANGE_ME@redis.example.org:6380/0
# JOB_REDIS_URL=rediss://:CHANGE_ME@redis.example.org:6380/1
# CELERY_BROKER_URL=rediss://:CHANGE_ME@redis.example.org:6380/2?ssl_cert_reqs=required
# CELERY_RESULT_BACKEND=rediss://:CHANGE_ME@redis.example.org:6380/3?ssl_cert_reqs=required
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# ALLOWED_ORIGINS=https://echo.example.org
# STORAGE_BACKEND=s3
# S3_BUCKET=echo-artifacts
# S3_ENDPOINT_URL=https://s3.example.org
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# ENABLE_LEGACY_SYNC_INFERENCE=false
# <<< production
