# Copy to .env for local Docker dev. .env is gitignored — never commit it.
#
# Where the client finds the API. Leave it unset: the client then calls port 8000
# on the host that served the page, which keeps the API the same site as the page
# so the session cookie is sent (http://127.0.0.1:8080 calls http://127.0.0.1:8000).
# Set it only when the API is elsewhere, e.g. behind a proxy in production; for the
# production image pass it as a build argument instead:
#   docker build --target prod --build-arg VITE_API_BASE_URL=https://api.example.org .
# VITE_API_BASE_URL=http://localhost:8000
